# ==============================================================================
# SMART PETROL PUMP ANALYTICS - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# Application & API Settings
PROJECT_NAME="Smart Petrol Pump Analytics"
VERSION="2.0.0"
API_V1_STR="/api"

# JWT Authentication & RBAC Security
JWT_SECRET_KEY="replace-this-with-a-cryptographically-secure-random-token-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Snowflake Enterprise Database Connection (Target: SPPA_WH / SMART_PETROL_DB)
SNOWFLAKE_ACCOUNT="your_snowflake_account_identifier" # e.g. xy12345.ap-south-1
SNOWFLAKE_USER="your_snowflake_username"
SNOWFLAKE_PASSWORD="your_snowflake_secure_password"
SNOWFLAKE_DATABASE="SMART_PETROL_DB"
SNOWFLAKE_WAREHOUSE="SPPA_WH"
SNOWFLAKE_ROLE="ACCOUNTADMIN"
SNOWFLAKE_SCHEMA="SALES_MANAGEMENT"

# Operational Mode
# When Snowflake credentials are empty or offline, high-fidelity demo engine auto-activates
DEMO_MODE=false

# Optional AI / LLM Integration (for conversational extensions)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
